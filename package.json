{
  "name": "scope-movie-assessment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit && npm test",
    "db:migrate": "node --experimental-strip-types --no-warnings --env-file=.env scripts/db.mjs migrate",
    "db:reset": "node --experimental-strip-types --no-warnings --env-file=.env scripts/db.mjs reset",
    "db:seed": "node --experimental-strip-types --no-warnings --env-file=.env scripts/db.mjs seed",
    "db:seed:scale": "node --experimental-strip-types --no-warnings --env-file=.env scripts/db.mjs seed-scale",
    "dev": "next dev --turbo",
    "evals": "tsx --conditions=react-server --env-file=.env evals/run.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "preview": "next build && next start",
    "start": "next start",
    "test": "tsx --conditions=react-server --import ./tests/setup.ts --test --test-reporter=spec tests/*.test.ts",
    "test:api": "node --test --test-reporter=spec tests/api/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@t3-oss/env-nextjs": "^0.12.0",
    "next": "^15.2.3",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@10.8.2"
}
