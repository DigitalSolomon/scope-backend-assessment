# Supabase transaction pooler (IPv4). The direct db.<ref>.supabase.co host is
# IPv6-only and is not reachable from Vercel or most local networks.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres"

# Gemini API key for ScopeBot (free): https://aistudio.google.com/apikey
# Server-side only; never commit the real value. Without it ScopeBot runs in a
# clearly labelled basic mode that uses rule-based matching.
GEMINI_API_KEY=""

# Optional. Defaults shown. See "Model and thinking level" in the README.
# GEMINI_MODEL="gemini-3.8-flash"
# GEMINI_THINKING_LEVEL="medium"          # minimal | low | medium | high
# GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"
